  "narrative": {
    "northStar": "The Bread Campaign",
    "overview": "Monumental lowercase lettering and isolated bread photographs make a direct, contemporary bakery campaign. Cool grey provides air; cobalt becomes both ink and a full section field; warm orange carries purchase actions and the process story. Bread supplies the texture while rules and open space organize the interface.\n\nUnbounded is reserved for the brand signature. Golos Text carries Cyrillic headlines, product information and shopping controls. The visual system supports an illustrative storefront with a local basket and downloadable pickup list; demo status remains explicit at the point of ordering.",
    "keyCharacteristics": [
      "Oversized lowercase brand with photographic overlap.",
      "Open product shelves, fine dividers and asymmetric desktop spans.",
      "Large rounded shopping controls with visible state feedback.",
      "Responsive recomposition and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Bread Object Rule",
        "body": "Let isolated product photography meet the section field directly; use the bread silhouette rather than a rectangular photo tile.",
        "section": "colors"
      },
      {
        "name": "The Brand Voice Rule",
        "body": "Reserve Unbounded for the lowercase brand; use Golos Text for headlines and all transactional reading.",
        "section": "typography"
      },
      {
        "name": "The Open Shelf Rule",
        "body": "Keep catalog products flat and separated by space and thin rules; reserve panel elevation for temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep product silhouettes and crust texture large and legible.",
      "Do preserve visible keyboard focus, named icon actions and reduced-motion behavior.",
      "Do show quantity feedback immediately and keep the demo-order disclosure beside checkout."
    ],
    "donts": [
      "Don't put raised card shells around every catalog product.",
      "Don't use the display wordmark face for dense shopping controls.",
      "Don't present illustrative products, prices or orders as verified business facts."
    ]
  }
