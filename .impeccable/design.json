  "narrative": {
    "northStar": "The Morning Bakery Counter",
    "overview": "Butter wrapping paper and bottle-green ink frame close bread photography. Prata supplies the quiet, expressive lettering; Manrope keeps shopping controls precise. Space and thin rules organize the page without raised card shells.\n\nThis is an illustrative concept, not a real bakery. Product facts, prices and the story are demonstration content; the cart creates a local pickup list without payment or order transmission. This document records the shipped React storefront, not a commercial identity supplied by a business.",
    "keyCharacteristics": [
      "Warm paper surfaces and dark green ink.",
      "Large serif headings beside restrained utility type.",
      "Close food photography, thin rules and small corner radii.",
      "Immediate shopping feedback and restrained, optional motion."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Use green for an action or a deliberate full-width field; keep product cards on the page surface.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Keep expressive headings in Prata and transactional controls in Manrope.",
        "section": "typography"
      },
      {
        "name": "The Flat Counter Rule",
        "body": "Preserve flat product cards; use elevation to distinguish temporary overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep bread photography close and large enough to show crust texture.",
      "Do use the Paper and Ink Rule, Two Voices Rule and Flat Counter Rule.",
      "Do preserve visible keyboard focus, readable placeholder text and reduced-motion behavior.",
      "Do disclose the local demonstration flow wherever an order could appear to be submitted."
    ],
    "donts": [
      "Don't add raised shells around every catalog product.",
      "Don't use Prata for dense transactional controls.",
      "Don't let a tablet photograph obscure the hero text.",
      "Don't present illustrative product claims as verified business facts."
    ]
  }
